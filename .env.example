# ==========================================
# 1. APPLICATION & SERVER SETTINGS
# ==========================================
APP_NAME=BulgariaFogMonitor
ENVIRONMENT=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# ==========================================
# 2. COPERNICUS SATELLITE & API CREDENTIALS
# ==========================================
# Note: Visibility is sourced from Open-Meteo (no key required).
# Copernicus credentials are reserved for future CAMS aerosol integration via cdsapi.
COPERNICUS_USER=your-email@domain.com
COPERNICUS_CLIENT_ID=sh-your-client-id-here
COPERNICUS_CLIENT_SECRET=your-client-secret-here

# ==========================================
# 3. INSTITUTIONAL WEBHOOKS & GATEWAYS (SIMULATION)
# ==========================================
API_ROAD_AGENCY_WEBHOOK=http://localhost:8000/api/mock/api-road-agency
BG_ALERT_GATEWAY_WEBHOOK=http://localhost:8000/api/mock/bg-alert
FIRE_SAFETY_WEBHOOK=http://localhost:8000/api/mock/pbzn-fire-safety
MUNICIPALITY_DISPATCH_WEBHOOK=http://localhost:8000/api/mock/municipality-crisis

# ==========================================
# 4. GEOSPATIAL & PROCESSING THRESHOLDS
# ==========================================
DEFAULT_SEARCH_RADIUS_KM=5
CRITICAL_VISIBILITY_THRESHOLD_METERS=50

# ==========================================
# 5. SUPABASE (OPTIONAL — FUTURE PERSISTENCE)
# ==========================================
# SUPABASE_DB_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres